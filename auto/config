#!/bin/sh
set -e

# Kernel Sec OS -- ISO "core" (live-build config)
# Debian bookworm base, XFCE desktop, Calamares installer.
# Kernel comes from local/packages.chroot (kernel-sec .deb's), not from
# Debian's stock linux-image -- see ../README.md.

# debootstrap's minimal bookworm base doesn't include gnupg, so the very
# first "apt update" inside the chroot fails with "gpg: No such file or
# directory" before any of our package lists ever get a chance to run.
# This live-build version has no --bootstrap-include CLI flag for it (grep
# the lb_config source -- LB_BOOTSTRAP_INCLUDE is env-var-only here), and it
# only takes effect on a fresh config tree, not an "update" of an existing
# one (rm -rf config/ .build/ first if re-running this after a failed build).
export LB_BOOTSTRAP_INCLUDE="gnupg"

# Deliberately NOT using --mode debian, even though LB_MODE auto-detected
# from the host (WSL2 Ubuntu -> "ubuntu") is the root cause of the wrong
# mirror and the ubuntu-keyring bug below. Traced lb_chroot_archives: for
# LB_MODE=debian, the non-progress branch hardcodes the *pre-2023* Debian
# security suite name "${dist}/updates", which 404s against the real
# archive today. The LB_MODE=ubuntu branch happens to write the modern
# "${dist}-security" name instead. So: keep the default (ubuntu) mode for
# correct security-suite naming, and override just the two things that
# default actually gets wrong for a Debian target -- mirror URLs and the
# keyring package -- explicitly instead.

lb config noauto \
    --architecture amd64 \
    --distribution bookworm \
    --archive-areas "main contrib non-free non-free-firmware" \
    --debian-installer none \
    --binary-images iso-hybrid \
    --bootappend-live "boot=live components quiet splash" \
    --mirror-bootstrap http://deb.debian.org/debian/ \
    --mirror-chroot http://deb.debian.org/debian/ \
    --mirror-chroot-security http://security.debian.org/debian-security/ \
    --mirror-binary http://deb.debian.org/debian/ \
    --mirror-binary-security http://security.debian.org/debian-security/ \
    --keyring-packages debian-archive-keyring \
    "${@}"
